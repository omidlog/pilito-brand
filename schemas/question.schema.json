{
  "$id": "https://brand-os.local/schemas/question.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interview question",
  "type": "object",
  "required": ["id", "module", "field_path", "prompt", "question_type", "priority", "sensitivity", "related_outputs", "depends_on", "why_it_matters"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "module": { "type": "string", "minLength": 2 },
    "field_path": { "type": "string", "minLength": 3 },
    "prompt": {
      "type": "object",
      "required": ["en", "fa", "tr"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "fa": { "type": "string", "minLength": 1 },
        "tr": { "type": "string", "minLength": 1 }
      }
    },
    "question_type": { "enum": ["short_text", "long_text", "single_choice", "boolean", "number", "url", "color", "font", "logo_spec", "voice_pairs", "relationships"] },
    "priority": { "enum": ["critical", "high", "medium", "low"] },
    "sensitivity": { "enum": ["public", "internal", "restricted"] },
    "approval_grant": { "enum": ["financial", "visual", "public_copy", "canonical"] },
    "publication_requires": { "type": "array", "items": { "enum": ["verified_evidence", "rights_permission"] }, "uniqueItems": true },
    "contact_field": { "type": "boolean" },
    "related_outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "why_it_matters": { "type": "string", "minLength": 1 }
  }
}
