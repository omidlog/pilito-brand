# Brand OS Studio configuration. Copy to a root-owned env file outside the repository on the host;
# never commit real values. Studio fails closed: a missing required value stops it at start-up, and
# error messages never echo a secret.

# Listener. Keep loopback; on a VPS the TLS reverse proxy is the only public listener.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=4100
# Public origin used for Origin/CSRF checks. https is required beyond loopback (and enables Secure cookies).
STUDIO_PUBLIC_ORIGIN=http://127.0.0.1:4100
# Set to 1 only behind a single reverse proxy on the same host, so rate limits see the client IP.
STUDIO_TRUST_PROXY=0
# Server-side registry, sync cache and provisioning work area (mode 0700). Not inside a brand repo.
STUDIO_DATA_DIR=.studio-data

# Owner sign-in. Create the hash with: npm run studio:hash-password
STUDIO_OWNER_LOGIN=
STUDIO_OWNER_PASSWORD_HASH=
# Required beyond loopback. Create with: npm run studio -- totp-secret
STUDIO_OWNER_TOTP_SECRET=
# 32 random bytes, base64. Create with: npm run studio -- session-secret
STUDIO_SESSION_SECRET=
STUDIO_SESSION_HOURS=12
STUDIO_IDLE_MINUTES=60

# GitHub. Two separate credentials, least privilege:
# - read: fine-grained token (or GitHub App installation) with Contents: read and Metadata: read on brand repositories.
# - provision: used only by the new-brand wizard; Administration: write (create from template) and Contents: write.
STUDIO_GITHUB_READ_TOKEN=
STUDIO_GITHUB_PROVISION_TOKEN=
# Accounts or organizations new private repositories may be created in (comma separated). Required with a provision token.
STUDIO_ALLOWED_OWNERS=
STUDIO_TEMPLATE_REPO=omidlog/brand-os-template
# Optional push webhook (at least 20 characters). Without it, Studio refreshes on view after STUDIO_SYNC_TTL_SECONDS and on Refresh.
STUDIO_GITHUB_WEBHOOK_SECRET=
STUDIO_SYNC_TTL_SECONDS=300
