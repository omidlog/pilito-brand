{
  "name": "brand-os-template",
  "version": "0.2.0",
  "private": true,
  "description": "Universal Brand OS with an integrated Business OS, documentation portal, design tokens, and a local interview agent.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "materialize": "tsx scripts/materialize.ts",
    "tokens:build": "tsx packages/design-tokens/src/cli.ts",
    "prepare:docs": "tsx scripts/prepare-docs.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/docs/tsconfig.json --noEmit",
    "lint": "eslint .",
    "validate": "tsx scripts/validate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "STUDIO_E2E_REQUIRED=1 node --import tsx --test tests/studio-browser.test.ts",
    "docs:start": "tsx scripts/prepare-docs.ts --audience internal && npm run start -w @brand-os/docs",
    "docs:build": "tsx scripts/prepare-docs.ts --audience public && npm run build -w @brand-os/docs",
    "docs:build:fa": "tsx scripts/prepare-docs.ts --audience public && npm run build -w @brand-os/docs -- --locale fa",
    "build:docs:nomascot": "tsx scripts/prepare-docs.ts --audience public --mascot false --gamification false && npm run build -w @brand-os/docs",
    "build": "npm run tokens:build && npm run docs:build",
    "ci": "npm run lint && npm run typecheck && npm run validate && npm run test && npm run build && npm run build:docs:nomascot",
    "brand:init": "tsx scripts/brand.ts init",
    "brand:interview": "tsx scripts/brand.ts interview",
    "brand:resume": "tsx scripts/brand.ts resume",
    "brand:next": "tsx scripts/brand.ts next",
    "brand:propose": "tsx scripts/brand.ts propose",
    "brand:status": "tsx scripts/brand.ts status",
    "brand:review": "tsx scripts/brand.ts review",
    "brand:validate": "tsx scripts/brand.ts validate",
    "brand:export": "tsx scripts/brand.ts export",
    "brand:approve": "tsx scripts/brand.ts approve",
    "brand:publish": "tsx scripts/brand.ts publish",
    "brand:document": "tsx scripts/brand.ts document",
    "brand:tokens:generate": "tsx scripts/brand.ts tokens:generate",
    "brand:tokens:approve": "tsx scripts/brand.ts tokens:approve",
    "brand:tokens:publish": "tsx scripts/brand.ts tokens:publish",
    "brand:query": "tsx scripts/brand.ts query",
    "brand:agent-token": "tsx scripts/brand.ts agent-token",
    "brand:doctor": "tsx scripts/brand.ts doctor",
    "brand:finance": "tsx scripts/brand.ts finance",
    "brand:backup": "tsx scripts/brand.ts backup",
    "brand:restore": "tsx scripts/brand.ts restore",
    "brand:migrate": "tsx scripts/brand.ts migrate",
    "brand:evidence": "tsx scripts/brand.ts evidence",
    "brand:retract": "tsx scripts/brand.ts retract",
    "brand:reset": "tsx scripts/brand.ts reset",
    "mcp:serve": "tsx scripts/mcp.ts",
    "studio:start": "tsx apps/studio/src/main.ts",
    "studio": "tsx apps/studio/src/cli.ts",
    "studio:hash-password": "tsx apps/studio/src/cli.ts hash-password",
    "example:education": "tsx scripts/example-run.ts education-app",
    "example:b2b": "tsx scripts/example-run.ts b2b-saas"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "22.19.21",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  }
}
