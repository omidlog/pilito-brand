{
  "$id": "https://brand-os.local/schemas/asset.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Asset record",
  "type": "object",
  "required": ["id", "name", "status", "path", "present", "visibility"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "status": { "type": "string" },
    "path": { "type": "string" },
    "present": { "type": "boolean" },
    "visibility": { "enum": ["public", "internal", "restricted"] },
    "checksum_sha256": { "type": ["string", "null"] },
    "approved_by": { "type": "string", "minLength": 1, "maxLength": 200 },
    "approved_at": { "type": "string" },
    "approved_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "derived_from": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^brand/assets-src/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "normalizer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "svgo": { "type": "string" } }
    },
    "approval_carried_from": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "render_check": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": { "enum": ["identical", "different", "unavailable"] },
        "renderer": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "checked_at": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "approval_reset": { "type": ["object", "null"] },
    "model_use": {
      "description": "May this file be given to a model or model provider? Absent means not_allowed. Recording a value sends nothing anywhere.",
      "enum": ["not_allowed", "local_only", "external_allowed"]
    },
    "subject": { "enum": ["portrait", "person", "case_study", "client_logo", "testimonial", null] },
    "rights": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["granted", "pending", "revoked", "none"] },
        "scope": { "enum": ["public", "internal"] },
        "holder": { "type": "string", "minLength": 1, "maxLength": 120 },
        "expires": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "evidence_id": { "type": ["string", "null"], "pattern": "^ev-\\d{4,}$" },
        "note": { "type": "string", "maxLength": 400 }
      }
    }
  }
}
