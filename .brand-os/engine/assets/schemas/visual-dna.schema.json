{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "brand-os/visual-dna/v1",
  "title": "Visual DNA references v1",
  "description": "Read-only verdicts for requested visual references (manifest assets, mascot artwork, creative-memory variants), resolved fresh from the canonical readers under the caller's own context. Metadata only: it never carries file bytes, stores nothing and authorizes nothing. $id is an identifier, not a deployed endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool", "status", "brand_id", "principal", "reason", "use_scope", "locale", "direction", "notice", "references", "mascot", "creative", "summary", "digest", "transport", "authorizes", "permissions"],
  "properties": {
    "schema": { "const": "brand-os/visual-dna/v1" },
    "tool": { "const": "visual_dna" },
    "status": { "enum": ["ok", "denied", "invalid"] },
    "brand_id": { "type": "string", "minLength": 1 },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "profile"],
      "properties": { "role": { "type": "string" }, "profile": { "type": ["string", "null"] } }
    },
    "reason": { "type": ["string", "null"] },
    "use_scope": { "enum": ["public", "internal"], "description": "The use the verdicts were checked for. Internal-scope rights cover a rights-sensitive subject only for internal use; an internal verdict is not permission to publish." },
    "locale": { "enum": ["en", "fa", "tr"] },
    "direction": { "enum": ["ltr", "rtl"] },
    "notice": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "references": { "type": "array", "maxItems": 60, "items": { "$ref": "#/definitions/reference" } },
    "mascot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "filters", "explanation"],
      "properties": {
        "status": { "enum": ["not_requested", "resolved", "missing", "not_applicable"] },
        "filters": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": { "emotion": { "type": "string" }, "stage": { "type": "string" }, "use_case": { "type": "string" }, "angle": { "type": "string" } }
        },
        "explanation": { "type": "array", "items": { "type": "string" } }
      }
    },
    "creative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "target", "preference_ids"],
      "properties": {
        "status": { "enum": ["not_requested", "ok", "not_authorized", "not_found", "invalid"] },
        "target": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["project_id", "surface", "series"],
          "properties": { "project_id": { "type": ["string", "null"] }, "surface": { "type": ["string", "null"] }, "series": { "type": ["string", "null"] } }
        },
        "preference_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "withheld", "missing", "changed"],
      "properties": {
        "approved": { "type": "integer", "minimum": 0 },
        "withheld": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 }
      }
    },
    "digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp", "bytes"],
      "properties": { "mcp": { "const": "metadata_only" }, "bytes": { "const": "owner_local_only" } }
    },
    "authorizes": { "type": "array", "maxItems": 0 },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publish", "schedule", "spend", "deploy", "approve", "upload"],
      "properties": {
        "publish": { "const": false },
        "schedule": { "const": false },
        "spend": { "const": false },
        "deploy": { "const": false },
        "approve": { "const": false },
        "upload": { "const": false }
      }
    }
  },
  "definitions": {
    "verdict": { "enum": ["blocked", "not_blocked_by_record"] },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "via", "asset_id", "state", "reason", "reason_text", "source", "asset", "rights", "model_use", "provider_gate", "delivery", "sent_to_model"],
      "properties": {
        "ref_id": { "type": "string", "minLength": 1 },
        "via": { "enum": ["asset", "mascot", "creative"] },
        "asset_id": { "type": ["string", "null"] },
        "state": { "enum": ["approved", "withheld", "missing", "changed"] },
        "reason": {
          "enum": [null, "not_found", "not_approved", "not_present", "no_artwork", "creative_asset_missing", "not_authorized", "rights", "license_missing", "unsafe_file", "too_large", "checksum_mismatch", "approved_bytes_differ", "creative_record_changed"]
        },
        "reason_text": { "type": ["string", "null"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "revision"],
          "properties": { "path": { "enum": ["brand/assets/asset-manifest.yaml", "brand/mascot/catalog.yaml"] }, "revision": { "type": ["string", "null"] } }
        },
        "asset": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name", "path", "media_type", "size_bytes", "checksum_sha256"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "path": { "type": "string", "pattern": "^brand/assets/" },
            "media_type": { "type": ["string", "null"] },
            "size_bytes": { "type": "integer", "minimum": 0 },
            "checksum_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "rights": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["license", "license_basis", "usage", "restrictions", "rights_subject"],
          "properties": {
            "license": { "type": ["string", "null"] },
            "license_basis": { "enum": ["recorded", "own_brand_mark"], "description": "own_brand_mark: the brand's own logo or mark with an empty or TBD licence; third-party assets always need a recorded licence." },
            "usage": { "type": ["string", "null"] },
            "restrictions": { "type": ["string", "null"] },
            "rights_subject": { "type": ["string", "null"] }
          }
        },
        "model_use": { "enum": ["not_allowed", "local_only", "external_allowed"] },
        "provider_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_model", "external_provider"],
          "properties": { "local_model": { "$ref": "#/definitions/verdict" }, "external_provider": { "$ref": "#/definitions/verdict" } }
        },
        "delivery": { "enum": ["metadata_only", "none"] },
        "sent_to_model": { "const": false },
        "mascot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["art_id", "state_id", "emotion", "stage", "angle"],
          "properties": {
            "art_id": { "type": ["string", "null"] },
            "state_id": { "type": ["string", "null"] },
            "emotion": { "type": ["string", "null"] },
            "stage": { "type": ["string", "null"] },
            "angle": { "type": ["string", "null"] }
          }
        },
        "creative": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "variant_id", "role"],
          "properties": { "project_id": { "type": "string" }, "variant_id": { "type": "string" }, "role": { "enum": ["selected", "rejected", "partial_keep"] } }
        }
      }
    }
  }
}
