{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "brand-os/runtime-post-manifest/v1",
  "title": "Runtime post manifest v1",
  "description": "One drafted social post: the SVG file, its digest, the task_context sources it cites by id and revision, the assets it considered, and the checks reported by the layers that own them. A draft for human review; it authorizes nothing. $id is an identifier, not a deployed endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "post_id",
    "index",
    "brand_id",
    "demo",
    "state",
    "locale",
    "direction",
    "angle",
    "layout",
    "format",
    "file",
    "sha256",
    "bytes",
    "renderer",
    "context",
    "sources",
    "assets",
    "typography",
    "export",
    "checks",
    "human_review_required",
    "authorizes",
    "permissions"
  ],
  "properties": {
    "schema": {
      "const": "brand-os/runtime-post-manifest/v1"
    },
    "post_id": {
      "type": "string",
      "pattern": "^post-[0-9]{2}$"
    },
    "index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "demo": {
      "type": "boolean"
    },
    "state": {
      "const": "draft"
    },
    "locale": {
      "enum": [
        "en",
        "fa",
        "tr"
      ]
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "angle": {
      "enum": [
        "promise",
        "differentiation",
        "value_proposition",
        "tagline",
        "audience",
        "offer",
        "purpose",
        "pillar"
      ]
    },
    "layout": {
      "enum": [
        "statement",
        "band",
        "frame",
        "split",
        "quote"
      ]
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "width",
        "height",
        "media_type"
      ],
      "properties": {
        "id": {
          "const": "instagram-portrait-1080x1350"
        },
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1350
        },
        "media_type": {
          "const": "image/svg+xml"
        }
      }
    },
    "file": {
      "type": "string",
      "pattern": "^posts/post-[0-9]{2}\\.svg$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "model",
        "network"
      ],
      "properties": {
        "name": {
          "const": "brand-os-svg-post-renderer"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "null"
        },
        "network": {
          "const": false
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_schema",
        "pack_sha256",
        "task_type"
      ],
      "properties": {
        "pack_schema": {
          "const": "brand-os/task-context/v1"
        },
        "pack_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_type": {
          "const": "social_batch"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "source_id",
          "source_revision"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "source_revision",
          "checksum_sha256",
          "model_use",
          "sent_to_model",
          "embedded",
          "not_embedded_reason"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "checksum_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_use": {
            "enum": [
              "not_allowed",
              "local_only",
              "external_allowed"
            ]
          },
          "sent_to_model": {
            "const": false
          },
          "embedded": {
            "type": "boolean"
          },
          "not_embedded_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "description": "The type drawn on the post: the approved brand.type.scale per slot (sizes × canvas_scale), or the renderer default, labelled as such. Weights come only from approved fontWeight tokens.",
      "additionalProperties": false,
      "required": [
        "applied",
        "canvas_scale",
        "slots",
        "headline"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "canvas_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline",
            "label",
            "body"
          ],
          "properties": {
            "headline": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "family_stack",
                "appended_generic",
                "size_px",
                "line_height",
                "weight",
                "family_source",
                "size_source",
                "line_height_source",
                "weight_source"
              ],
              "properties": {
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "family_stack": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "appended_generic": {
                  "type": "boolean"
                },
                "size_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "line_height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "family_source": {
                  "enum": [
                    "approved",
                    "renderer_default"
                  ]
                },
                "size_source": {
                  "enum": [
                    "approved",
                    "renderer_default"
                  ]
                },
                "line_height_source": {
                  "enum": [
                    "approved",
                    "renderer_default"
                  ]
                },
                "weight_source": {
                  "enum": [
                    "approved_token",
                    "renderer_default"
                  ]
                }
              }
            },
            "label": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "family_stack",
                "appended_generic",
                "size_px",
                "line_height",
                "weight",
                "family_source",
                "size_source",
                "line_height_source",
                "weight_source"
              ],
              "properties": {
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "family_stack": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "appended_generic": {
                  "type": "boolean"
                },
                "size_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "line_height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "family_source": {
                  "enum": [
                    "approved",
                    "renderer_default"
                  ]
                },
                "size_source": {
                  "enum": [
                    "approved",
                    "renderer_default"
                  ]
                },
                "line_height_source": {
                  "enum": [
                    "approved",
                    "renderer_default"
                  ]
                },
                "weight_source": {
                  "enum": [
                    "approved_token",
                    "renderer_default"
                  ]
                }
              }
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "family_stack",
                "appended_generic",
                "size_px",
                "line_height",
                "weight",
                "family_source",
                "size_source",
                "line_height_source",
                "weight_source"
              ],
              "properties": {
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "family_stack": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "appended_generic": {
                  "type": "boolean"
                },
                "size_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "line_height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "family_source": {
                  "enum": [
                    "approved",
                    "renderer_default"
                  ]
                },
                "size_source": {
                  "enum": [
                    "approved",
                    "renderer_default"
                  ]
                },
                "line_height_source": {
                  "enum": [
                    "approved",
                    "renderer_default"
                  ]
                },
                "weight_source": {
                  "enum": [
                    "approved_token",
                    "renderer_default"
                  ]
                }
              }
            }
          }
        },
        "headline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_px",
            "drawn_px",
            "reduced_to_fit"
          ],
          "properties": {
            "start_px": {
              "type": "number"
            },
            "drawn_px": {
              "type": "number"
            },
            "reduced_to_fit": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "description": "draft: live, editable text. final: text converted to outlines locally with owner-supplied font files, recorded by file name and sha256 (never by path).",
      "additionalProperties": false,
      "required": [
        "mode",
        "text",
        "outliner",
        "fonts"
      ],
      "properties": {
        "mode": {
          "enum": [
            "draft",
            "final"
          ]
        },
        "text": {
          "enum": [
            "live",
            "outlined"
          ]
        },
        "outliner": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "const": "resvg-js"
                },
                "version": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file_name",
              "sha256",
              "families"
            ],
            "properties": {
              "file_name": {
                "type": "string",
                "pattern": "^[^/\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/check"
      }
    },
    "human_review_required": {
      "const": true
    },
    "authorizes": {
      "type": "array",
      "maxItems": 0
    },
    "permissions": {
      "$ref": "#/definitions/permissions"
    }
  },
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "layer",
        "method",
        "result",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z_]+\\.[a-z_]+$"
        },
        "layer": {
          "enum": [
            "asset-catalog.svg-check",
            "asset-catalog.publication",
            "asset-catalog.normalize",
            "content-bridge.claims",
            "design-tokens.contrast",
            "task-context.pack",
            "runtime.manifest"
          ]
        },
        "method": {
          "const": "deterministic"
        },
        "result": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_tested"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publish",
        "schedule",
        "spend",
        "deploy",
        "approve"
      ],
      "properties": {
        "publish": {
          "const": false
        },
        "schedule": {
          "const": false
        },
        "spend": {
          "const": false
        },
        "deploy": {
          "const": false
        },
        "approve": {
          "const": false
        }
      }
    }
  }
}
