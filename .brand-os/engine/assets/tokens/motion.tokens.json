{
  "$description": "EXAMPLE motion tokens. Reduced motion zeros these durations in the CSS export.",
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 120, "unit": "ms" }, "$description": "EXAMPLE fast duration." },
      "standard": { "$value": { "value": 200, "unit": "ms" }, "$description": "EXAMPLE standard duration." },
      "moderate": { "$value": { "value": 320, "unit": "ms" }, "$description": "EXAMPLE moderate duration." },
      "expressive": { "$value": { "value": 480, "unit": "ms" }, "$description": "EXAMPLE expressive duration." }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1], "$description": "EXAMPLE standard easing." },
      "entrance": { "$value": [0, 0, 0.2, 1], "$description": "EXAMPLE entrance easing." },
      "exit": { "$value": [0.4, 0, 1, 1], "$description": "EXAMPLE exit easing." }
    }
  }
}
